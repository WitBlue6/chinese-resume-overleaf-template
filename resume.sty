% Section ribbon and icons are drawn as vectors.
\newcommand{\SectionIcon}[1]{%
\ifnum#1=0
  \begin{tikzpicture}[x=1mm,y=1mm]
    \path[use as bounding box] (0,0) rectangle(7,6);
    \fill[white] (.3,3.8)--(3.5,5.3)--(6.7,3.8)--(3.5,2.3)--cycle;
    \draw[white,line width=.45mm] (1.5,3)--(1.5,1.9)--(3.5,1)--(5.5,1.9)--(5.5,3);
    \draw[white,line width=.3mm] (6.5,3.8)--(6.5,1.6);
  \end{tikzpicture}%
\else\ifnum#1=2
  \begin{tikzpicture}[x=1mm,y=1mm]
    \path[use as bounding box] (0,0) rectangle(7,6);
    \fill[white] (1.3,.6) rectangle(5.7,4.6);
    \fill[white] (.9,4.9) rectangle(6.1,5.6);
    \draw[ResumeBlue,line width=.4mm] (2.7,3.5)--(4.3,3.5);
  \end{tikzpicture}%
\else
  \begin{tikzpicture}[x=1mm,y=1mm]
    \path[use as bounding box] (0,0) rectangle (7,6);
    \ifnum#1=1
      \draw[white,line width=.5mm,rounded corners=.3mm] (.8,1) rectangle (6.2,4.5);
      \draw[white,line width=.5mm] (2.3,4.5)--(2.3,5.4)--(4.7,5.4)--(4.7,4.5);
      \draw[white,line width=.35mm] (.8,2.7)--(6.2,2.7);
    \fi
    \ifnum#1=3
      \draw[white,line width=.45mm] (1.6,5.5)--(1.6,2.3) arc (180:360:1.9)--(5.4,5.5);
      \draw[white,line width=.45mm] (1,5.2)--(1,3.9) arc (180:270:1.2);
      \draw[white,line width=.45mm] (6,5.2)--(6,3.9) arc (0:-90:1.2);
      \draw[white,line width=.45mm] (3.5,2.2)--(3.5,.8)--(2.2,.8)--(4.8,.8);
    \fi
    \ifnum#1=4
      \draw[white,line width=.45mm,rounded corners=.3mm] (.8,1) rectangle (6.2,5);
      \draw[white,line width=.35mm] (1.7,3.7)--(2.5,3)--(1.7,2.3);
      \draw[white,line width=.35mm] (3,2.2)--(4.8,2.2);
    \fi
  \end{tikzpicture}%
\fi\fi}
\newcommand{\ResumeSection}[2]{%
  \par\addvspace{3bp}\Needspace{42bp}%
  \noindent\begin{tikzpicture}[x=1mm,y=1mm,baseline=0mm]
    \path[use as bounding box] (0,0) rectangle(179,6.5);
    \fill[ResumeBlue] (0,0) rectangle(35,6.5);
    \fill[ResumeBlue] (0,0) rectangle(179,.5);
    \node[inner sep=0] at (5.2,3.4) {\SectionIcon{#1}};
    \node[anchor=west,inner sep=0,text=white,font=\normalfont\ResumeTitleFont\fontsize{14bp}{16bp}\selectfont] at (10,3.35) {#2};
  \end{tikzpicture}\par\nobreak\vspace{-1.5bp}}
\newcommand{\Education}[3]{%
  \noindent\hspace{.7mm}{\ResumeBlueBold\makebox[36mm][l]{#1}\makebox[115.3mm][c]{#2}\makebox[35mm][r]{#3}}\par}
\newcommand{\Entry}[2]{%
  \par\Needspace{36bp}\noindent\hspace{.7mm}{\ResumeBlueBold #1\hfill #2\hspace{4mm}}\par\nobreak}
\newcommand{\Description}[1]{\noindent\hspace{.7mm}#1\par\nobreak}
\newcommand{\AwardRow}[2]{%
  \noindent\makebox[7mm][l]{\ResumeArrow}\makebox[106mm][l]{#1}#2\par}
\newcommand{\SkillHead}[2]{%
  \noindent\makebox[108mm][l]{\hspace{2.7mm}{\ResumeBlueBold #1}}{\ResumeBlueBold #2}\par}
\newcommand{\SkillRow}[2]{%
  \noindent\hspace{.7mm}\makebox[104.3mm][l]{-\enspace #1}-\enspace #2\par}
