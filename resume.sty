\AtBeginDocument{\color{ResumeText}\fontsize{10bp}{18bp}\selectfont}
\newcommand{\ResumeBlueBold}{\color{ResumeBlue}\bfseries\fontsize{11bp}{18bp}\selectfont}
% Draw the original arrow instead of relying on Wingdings.
\newcommand{\ResumeArrow}{\tikz[baseline=-.5bp,x=1bp,y=1bp]{%
  \draw[ResumeText,line width=.4bp] (0,0)--(5,3)--(0,6)--(1.8,3)--cycle;
  \draw[ResumeText,line width=.35bp] (1.8,3)--(5,3);}}
\newlist{resumeitems}{itemize}{1}
\setlist[resumeitems]{label=\ResumeArrow,leftmargin=8.2mm,labelwidth=2.3mm,labelsep=5.9mm,
  topsep=0pt,partopsep=0pt,itemsep=0pt,parsep=0pt}
\newcommand{\Point}[2]{\item \textbf{#1}#2}
% Header icons, independent of operating-system symbol fonts.
\newcommand{\ContactIcon}[1]{%
  \begin{tikzpicture}[x=1mm,y=1mm,baseline=-1mm]
  \fill[ResumeBlue] (0,0) circle(2.5);
  \begin{scope}[white,line width=.35mm]
  \ifcase#1\relax
    \draw (0,0) circle(1.5);\draw (0,1)--(0,0)--(.8,-.6);
  \or
    \draw (0,1.5) .. controls (-2,1.5) and (-1,-.6) .. (0,-1.6)
      .. controls (1,-.6) and (2,1.5) .. (0,1.5);\fill (0,.6) circle(.5);
  \or
    \draw[rounded corners=.2mm] (-1.4,-1) rectangle(1.4,1);
    \draw (-.6,1)--(-.6,1.5)--(.6,1.5)--(.6,1);\draw (-1.4,.35)--(1.4,.35);
  \or
    \fill (0,.85) circle(.85);\fill (-1.5,-1.2) .. controls (-1.5,.3) and (1.5,.3) .. (1.5,-1.2)--cycle;
  \or
    \draw[rounded corners=.2mm] (-.9,-1.5) rectangle(.9,1.5);\fill (0,-1) circle(.15);
  \or
    \draw (-1.6,-1) rectangle(1.6,1);\draw (-1.6,1)--(0,-.1)--(1.6,1);
  \fi
  \end{scope}\end{tikzpicture}}
